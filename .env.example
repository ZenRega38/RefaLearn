# ==============================================================================
# Refa Learn — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local` — it's already covered by .gitignore's `.env*` rule.
# ==============================================================================

# --- Supabase --------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
# Safe to expose to the browser (prefixed with NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings → API → service_role key.
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never import into a
# client component — this key bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (transactional email) -------------------------------------------
# https://resend.com/api-keys — SERVER-ONLY.
RESEND_API_KEY=your-resend-api-key

# Optional. Must be a domain verified in your Resend account, formatted as
# "Display Name <email@yourdomain.com>". If omitted, falls back to Resend's
# shared sandbox sender (onboarding@resend.dev) — fine for dev/testing, but
# it will only deliver to the email address on your Resend account.
RESEND_FROM_EMAIL=Refa Learn <notifications@refalearn.com>

# --- Site -------------------------------------------------------------------
# Used for absolute URLs in emails, sitemap, and OpenGraph tags.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron protection ----------------------------------------------------------
# Random secret string. The monthly invoice-generation cron endpoint
# (app/api/cron/generate-invoices) checks the incoming request's
# Authorization header against this value and rejects anything else.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your-random-secret-string

# --- Cloudflare Turnstile (captcha on login/register/forgot password) ------
# Required: the auth forms stay disabled without it. Also enable Turnstile
# under Supabase → Authentication → Attack Protection with the secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
